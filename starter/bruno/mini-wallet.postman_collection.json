{
  "info": {
    "name": "Mini Wallet Starter - Import",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Import vào Bruno bằng Import Collection > Postman Collection. Biến đã có sẵn trong collection; không cần environment riêng. Chạy API localhost:3000 và migration trước. Đổi username khi chạy lại vì database yêu cầu duy nhất. Chỉ bao gồm endpoint đã triển khai."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "username",
      "value": "alice01",
      "type": "string"
    },
    {
      "key": "memberId",
      "value": "11111111-1111-4111-8111-111111111111",
      "type": "string"
    },
    {
      "key": "walletId",
      "value": "22222222-2222-4222-8222-222222222222",
      "type": "string"
    },
    {
      "key": "missingMemberId",
      "value": "00000000-0000-4000-8000-000000000000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Kiểm tra kết nối PostgreSQL. Không có params/body. Response: {\"status\":\"ok\"}."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 Create Member",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/members",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members"
          ]
        },
        "description": "username: string bắt buộc, 3–64 ký tự, duy nhất. Đổi username trước mỗi lần tạo lại. Tự lưu memberId và walletId từ response. Response: {\"member\":{\"id\":\"<uuid>\",\"username\":\"alice01\"},\"wallet\":{\"id\":\"<uuid>\",\"balance\":\"0\"}}.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set(\"memberId\", body.member.id);",
              "  pm.collectionVariables.set(\"walletId\", body.wallet.id);",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "03 Get Member Wallet",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/members/{{memberId}}/wallet",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "members",
            "{{memberId}}",
            "wallet"
          ]
        },
        "description": "Path param memberId: UUID thành viên thật. Chạy Create Member trước hoặc điền biến collection. Không có query/body. Response: {\"id\":\"<wallet UUID>\",\"memberId\":\"<member UUID>\",\"balance\":\"0.000000000000000000\"}."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
