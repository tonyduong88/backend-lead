PORT=3000
# db:bootstrap generates .env.runtime for API and .env.ops for privileged tools,
# with random local passwords. Never deploy .env.ops with the API. Explicit
# shell variables take priority. Existing .env files are never overwritten.
ADMIN_DATABASE_URL=postgres://wallet:wallet@localhost:5439/wallet
DATABASE_URL=postgres://wallet_app:wallet_app_local@localhost:5439/wallet
DATABASE_URL_MIGRATIONS=postgres://wallet_migrator:wallet_migrator_local@localhost:5439/wallet
DATABASE_URL_TEST=postgres://wallet_test_app:wallet_test_app_local@localhost:5439/wallet_test
DATABASE_URL_TEST_OWNER=postgres://wallet_test_owner:wallet_test_owner_local@localhost:5439/wallet_test
TEST_DATABASE_ALLOWLIST=wallet_test
DB_POOL_MAX=5
DB_POOL_ACQUIRE_MS=3000
DB_POOL_IDLE_MS=10000
DB_LOCK_TIMEOUT_MS=1500
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
DB_TRANSACTION_DEADLINE_MS=15000
MAX_IN_FLIGHT=64
PSP_MOCK_ENABLED=true
DB_SSL=false
